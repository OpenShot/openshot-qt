{
  "name": "Blend + Restyle (Multi-Input Demo)",
  "menu_category": "enhance",
  "menu_order": 99,
  "action_icon": "ai-action-restyle.svg",
  "output_type": "image",
  "template_id": "image-blend-multi-input-demo",
  "extra_inputs": [
    { "key": "overlay_image", "type": "image", "label": "Overlay image", "required": true },
    { "key": "style_prompt", "type": "text", "label": "Restyle prompt", "required": true }
  ],
  "workflow": {
    "1": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "__openshot_input__",
        "upload": "image"
      }
    },
    "2": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "__openshot_input:overlay_image__",
        "upload": "image"
      }
    },
    "3": {
      "class_type": "ImageBlend",
      "inputs": {
        "image1": ["1", 0],
        "image2": ["2", 0],
        "blend_factor": 0.5,
        "blend_mode": "normal"
      }
    },
    "4": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "sd_xl_base_1.0.safetensors"
      }
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["4", 1],
        "text": "__openshot_input:style_prompt__"
      }
    },
    "6": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["4", 1],
        "text": "blurry, low quality, watermark, text, logo"
      }
    },
    "7": {
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": ["3", 0],
        "vae": ["4", 2]
      }
    },
    "8": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["4", 0],
        "positive": ["5", 0],
        "negative": ["6", 0],
        "latent_image": ["7", 0],
        "seed": 1293041938,
        "steps": 20,
        "cfg": 6.0,
        "sampler_name": "dpmpp_2m_sde",
        "scheduler": "karras",
        "denoise": 0.5
      }
    },
    "9": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["8", 0],
        "vae": ["4", 2]
      }
    },
    "10": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "openshot_gen",
        "images": ["9", 0]
      }
    }
  }
}
