      "_meta": { "title": "SplitSigmas" }
    },
    "3920": {
      "inputs": { "input": "__openshot_input:output_length__" },
      "class_type": "Basic data handling: CastToInt",
      "_meta": { "title": "Output Length (frames)" }
    },
    "clipA_probe": {
      "inputs": {
        "video": "__openshot_input__",
        "force_rate": 0,
        "custom_width": 0,
        "custom_height": 0,
        "frame_load_cap": 1,
        "skip_first_frames": 0,
        "select_every_nth": 1,
        "format": "AnimateDiff"
      },
      "class_type": "VHS_LoadVideo",
      "_meta": { "title": "Clip A Probe (cheap length check)" }
    },
    "clipA_video_info": {
      "inputs": { "video_info": ["clipA_probe", 3] },
      "class_type": "VHS_VideoInfoSource",
      "_meta": { "title": "Clip A Source Info" }
    },
    "clipA_skip_frames": {
      "inputs": {
        "expression": "max(a * d / b - 100, 0)",
        "values.a": ["clipA_video_info", 1],
        "values.b": ["clipA_video_info", 0],
        "values.d": ["3957", 0]
      },
      "class_type": "ComfyMathExpression",
      "_meta": { "title": "Clip A Skip (dense window, for AddGuide only)" }
    },
    "clipA_ref_skip_frames": {
      "inputs": {
        "expression": "max(a * d / b - 192, 0)",
        "values.a": ["clipA_video_info", 1],
        "values.b": ["clipA_video_info", 0],
        "values.d": ["3957", 0]
      },
      "class_type": "ComfyMathExpression",
      "_meta": { "title": "Clip A Ref Skip (192-frame span, subsampled 2x -> 96 frames, video only)" }
    },
    "clipA_ref_audio_skip_frames": {
      "inputs": {
        "expression": "max(a * d / b - 294, 0)",
