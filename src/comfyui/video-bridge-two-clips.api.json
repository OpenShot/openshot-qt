    "3982": {
      "inputs": {
        "string": "subject_definitions:\n<Subject 1> is __openshot_input:subject_description__, visible in both reference videos, whose appearance, wardrobe, and voice come from <Video 1> and <Video 2>.\n<Video 1> is the continuation starting point for the target video.\n<Video 2> is the arrival point the target video must reach by its final frame.\n<Audio 1> is the voice-timbre reference for <Subject 1>, retained for consistency without copying the original signal.\n<Audio 2> is the voice-timbre reference for <Subject 1>, retained for consistency without copying the original signal.\n\nsummary:\nOne continuous shot that begins exactly where <Video 1> leaves off and arrives exactly at the opening moment of <Video 2>.\n\nretention_analysis:\n<Subject 1>'s identity, wardrobe, and voice timbre remain unchanged throughout. Any other people, objects, props, or background elements visible in <Video 1> or <Video 2> are preserved exactly as shown in whichever reference they appear in — nothing is added that isn't visible in either reference.\n\ndetailed_description:\n[Shot 1] Continues directly from the action, pose, and camera motion established at the end of <Video 1>.\n[Shot 2] Bridges naturally toward the position, pose, and motion seen at the start of <Video 2>.\n[Shot 3] Arrives at <Video 2>'s opening composition and motion, matching it exactly.\n__openshot_input:dialogue__\n\noverall_soundscape:\nThe ambient background sound at the end of <Video 1> continues and transitions naturally into the ambient background sound at the start of <Video 2>.\n\nnon_diegetic_music: N/A",
        "strip_newlines": true
      },
      "class_type": "StringConstantMultiline",
      "_meta": { "title": "Prompt" }
    },
    "prompt_override_holder": {
      "inputs": {
        "string": "__openshot_prompt__",
        "strip_newlines": false
      },
      "class_type": "StringConstantMultiline",
      "_meta": { "title": "OpenShot Prompt Field (raw)" }
    },
    "prompt_override_compare": {
      "inputs": {
        "string_a": ["prompt_override_holder", 0],
        "string_b": "__openshot_prompt__",
        "mode": "Equal",
        "case_sensitive": true
      },
      "class_type": "StringCompare",
      "_meta": { "title": "Prompt Field Left Blank? (still the literal placeholder)" }
    },
    "prompt_override_bool_int": {
