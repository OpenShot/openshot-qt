      "class_type": "Basic data handling: CastToInt",
      "_meta": { "title": "Prompt Field Left Blank? (to int)" }
    },
    "prompt_override_select": {
      "inputs": {
        "expression": "2 - a",
        "values.a": ["prompt_override_bool_int", 0]
      },
      "class_type": "ComfyMathExpression",
