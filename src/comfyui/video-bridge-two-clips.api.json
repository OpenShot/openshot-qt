    },
    "clipA_load": {
      "inputs": {
        "video": "__openshot_input__",
        "force_rate": 24,
        "custom_width": 0,
        "custom_height": 0,
        "frame_load_cap": 100,
        "skip_first_frames": ["clipA_skip_frames", 1],
        "select_every_nth": 1,
        "format": "AnimateDiff"
      },
      "class_type": "VHS_LoadVideo",
