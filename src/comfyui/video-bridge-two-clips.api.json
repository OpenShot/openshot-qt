{
  "name": "Bridge to Next Clip...",
  "menu_category": "enhance",
  "menu_order": 51,
  "action_icon": "ai-action-create-video.svg",
  "input_type": "video",
  "open_dialog": true,
  "output_type": "video",
  "template_id": "video-bridge-two-clips",
  "default_prompt": "subject_definitions:\nS1 is the central subject, visible in both reference videos, whose appearance, wardrobe, and voice come from V1 and V2.\nV1 is the continuation starting point for the target video.\nV2 is the arrival point the target video must reach by its final frame.\nA1 is the voice-timbre reference for S1, retained for consistency without copying the original signal.\nA2 is the voice-timbre reference for S1, retained for consistency without copying the original signal.\n\nsummary:\nOne continuous shot that begins exactly where V1 leaves off and arrives exactly at the opening moment of V2.\n\nretention_analysis:\nS1's identity, wardrobe, and voice timbre remain unchanged throughout. Any other people, objects, props, or background elements visible in V1 or V2 are preserved exactly as shown in whichever reference they appear in — nothing is added that isn't visible in either reference.\n\ndetailed_description:\n[Shot 1] Continues directly from the action, pose, and camera motion established at the end of V1.\n[Shot 2] Bridges naturally toward the position, pose, and motion seen at the start of V2.\n[Shot 3] Arrives at V2's opening composition and motion, matching it exactly.\nThere is no scripted dialogue.\n\noverall_soundscape:\nThe ambient background sound at the end of V1 continues and transitions naturally into the ambient background sound at the start of V2.\n\nnon_diegetic_music: N/A",
  "extra_inputs": [
    { "key": "clip_b", "type": "video", "label": "Arrival clip (Clip B)", "required": true },
    { "key": "subject_description", "type": "text", "label": "Subject description", "required": true, "default": "the central subject" },
    { "key": "dialogue", "type": "text", "label": "Dialogue (edit for a spoken line, e.g. <Subject 1> (S1) says: \"[English] your line here\")",
      "required": true, "default": "There is no scripted dialogue." },
    { "key": "clip_frames", "type": "choice", "label": "Clip frames to use (N)", "required": true,
      "choices": ["5", "22", "39", "56", "73", "90"], "default": "22" },
    { "key": "trim_output", "type": "choice", "label": "Trim head reference frames from output (the tail that arrives at Clip B is kept)", "required": true,
      "choices": ["yes", "no"], "default": "yes" },
    { "key": "output_length", "type": "choice", "label": "Output length (frames, 24fps)", "required": true,
      "choices": ["56", "73", "90", "124", "158", "192", "260", "328"], "default": "192" },
    { "key": "ref_subsample", "type": "choice", "label": "Reference video subsample rate (every Nth frame, over a fixed 192-frame span)",
      "required": true, "choices": ["1", "2", "3", "4"], "default": "2" }
  ],
  "workflow": {
    "125": {
      "inputs": {
        "noise": ["129", 0],
