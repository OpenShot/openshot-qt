    },
    "ref_subsample_n": {
      "inputs": { "input": "__openshot_input:ref_subsample__" },
      "class_type": "Basic data handling: CastToInt",
      "_meta": { "title": "Reference Video Subsample Rate (every Nth frame)" }
    },
    "ref_frame_cap": {
      "inputs": {
        "expression": "192 / a",
        "values.a": ["ref_subsample_n", 0]
