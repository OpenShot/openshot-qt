    "3901": {
      "inputs": {
        "strings": "0.9035, 0.6316, 0.3158, 0.0000\n0.9035, 0.8000, 0.6316, 0.3158, 0.0000\n0.9231, 0.8780, 0.8000, 0.6316, 0.3158, 0.0000",
