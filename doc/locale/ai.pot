#: ../doc/ai.rst:139
msgid "Workflow Templates"
msgstr ""

#: ../doc/ai.rst:141
msgid "OpenShot reads built-in templates from ``comfyui/``. It also loads custom user templates from ``~/.openshot_qt/comfyui/``."
msgstr ""

