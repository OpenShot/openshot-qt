msgid "Troubleshooting Recording"
msgstr "রেকর্ডিং সমস্যা সমাধান"

#: ../doc/recording.rst:317
msgid "Common recording problems"
msgstr "সাধারণ রেকর্ডিং সমস্যা"

#: ../doc/recording.rst:321
msgid "Problem"
msgstr "সমস্যা"

#: ../doc/recording.rst:321
msgid "What to Check"
msgstr "যা পরীক্ষা করবেন"

#: ../doc/recording.rst:323
msgid "Mic meter does not move"
msgstr "মাইক্রোফোন মিটার সরছে না"

#: ../doc/recording.rst:323
msgid ""
"Select the correct Input, verify OS microphone permission, and check "
"mute/gain."
msgstr ""
"সঠিক ইনপুট নির্বাচন করুন, OS মাইক্রোফোন অনুমতি যাচাই করুন, এবং মিউট/গেইন "
"পরীক্ষা করুন।"

#: ../doc/recording.rst:324
msgid "Mic clips or distorts"
msgstr "মাইক্রোফোন ক্লিপ বা বিকৃত হয়"

#: ../doc/recording.rst:324
msgid "Lower hardware/input gain and keep peaks below full scale."
msgstr "হার্ডওয়্যার/ইনপুট গেইন কমান এবং পিকগুলো ফুল স্কেলের নিচে রাখুন।"

#: ../doc/recording.rst:325
msgid "Mic is very quiet"
msgstr "মাইক্রোফোন খুব শান্ত"

#: ../doc/recording.rst:325
msgid ""
