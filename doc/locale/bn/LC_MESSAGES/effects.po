msgstr "``(color)`` নির্বাচিত বিষয়ের উপর আঁকা রঙ।"

#: ../doc/effects.rst:1378 ../doc/effects.rst:1465
msgid "mask_alpha"
msgstr "mask_alpha"

#: ../doc/effects.rst:1378
msgid "``(float, 0 to 1)`` Opacity of the colored mask overlay."
msgstr "``(float, 0 থেকে 1)`` রঙিন মাস্ক ওভারলের অস্বচ্ছতা।"

#: ../doc/effects.rst:1379
msgid "stroke_color"
msgstr "stroke_color"

#: ../doc/effects.rst:1379
