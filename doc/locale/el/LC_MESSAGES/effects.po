msgstr ""
"``(float, 0 to 1)`` Ελέγχει την οπτική πυκνότητα, όπως μπάρες, σημεία ή "
"σωματίδια"

#: ../effects.rst:521
msgid "glow"
msgstr ""

#: ../effects.rst:521
msgid "``(float, 0 to 1)`` Adds soft glow around the visualization"
msgstr "``(float, 0 to 1)`` Προσθέτει απαλή λάμψη γύρω από την οπτικοποίηση"

#: ../effects.rst:522
msgid "color_spread"
msgstr ""

#: ../effects.rst:522
msgid ""
"``(float, 0 to 1)`` Controls color variation around the seed color or "
"rainbow mode"
msgstr ""
"``(float, 0 to 1)`` Ελέγχει τη χρωματική διακύμανση γύρω από το χρώμα-βάση ή"
" τη λειτουργία ουράνιου τόξου"

