msgid ":ref:`clips_ref` for trimming, slicing, and clip properties"
msgstr ":ref:`clips_ref` για περικοπή άκρων, κόψιμο και ιδιότητες κλιπ"

#: ../timeline.rst:152
msgid ":ref:`effects_ref` for video/audio effects"
msgstr ":ref:`effects_ref` για εφέ βίντεο/ήχου"

#: ../timeline.rst:153
msgid ":ref:`animation_ref` for keyframe animation workflows"
msgstr ":ref:`animation_ref` για ροές εργασίας κίνησης με βασικά καρέ"

