msgstr ""
"``(float, -500 से 500)`` छाया का ऑफसेट दूरी पिक्सेल में। नकारात्मक मान छाया "
"को विपरीत दिशा में ले जाते हैं।"

#: ../doc/effects.rst:1569
msgid "angle"
msgstr "angle"

#: ../doc/effects.rst:1569
msgid ""
