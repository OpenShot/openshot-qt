msgstr "``Mic-<timestamp>``"

#: ../recording.rst:75
msgid "Microphone only"
msgstr "Nur Mikrofon"

#: ../recording.rst:76
msgid "Narration, voice-over, commentary, or interviews."
msgstr "Erzählung, Voice-over, Kommentar oder Interviews."

#: ../recording.rst:77 ../recording.rst:110 ../recording.rst:194
#: ../recording.rst:275
msgid "Screen"
msgstr "Bildschirm"

#: ../recording.rst:78
msgid "``Screen-<timestamp>.mp4``"
msgstr "``Screen-<timestamp>.mp4``"

#: ../recording.rst:79
msgid "Optional system audio"
msgstr "Optionales Systemaudio"

#: ../recording.rst:80
msgid "Tutorials, demonstrations, presentations, or games."
msgstr "Tutorials, Demonstrationen, Präsentationen oder Spiele."

