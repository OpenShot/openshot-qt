msgid "Screen capture modes"
msgstr "Bildschirmaufnahme-Modi"

#: ../recording.rst:175
msgid "Mode"
msgstr "Modus"

#: ../recording.rst:177
msgid "Full Screen"
msgstr "Vollbild"

#: ../recording.rst:177
msgid "Captures the selected display or combined desktop area."
