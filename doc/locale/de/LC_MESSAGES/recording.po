#: ../recording.rst:194
msgid "Selects a display or the complete desktop when supported."
msgstr "Wählt einen Bildschirm oder den gesamten Desktop, wenn unterstützt."

#: ../recording.rst:195
msgid "Offset"
msgstr "Versatz"

#: ../recording.rst:195 ../recording.rst:196
msgid "Selected bounds"
