msgstr "przezroczystość_maski"

#: ../effects.rst:1378
msgid "``(float, 0 to 1)`` Opacity of the colored mask overlay."
msgstr "``(float, 0 do 1)`` Przezroczystość kolorowej nakładki maski."

#: ../effects.rst:1379
msgid "stroke_color"
msgstr "kolor_obrysu"

#: ../effects.rst:1379
msgid "``(color)`` Color of the outline around the selected subject."
msgstr "``(color)`` Kolor obrysu wokół wybranego obiektu."

# Translated with gpt-4.1-mini
#: ../effects.rst:1380 ../effects.rst:1460 ../effects.rst:1767
msgid "stroke_alpha"
msgstr "przezroczystość obrysu"

#: ../effects.rst:1380
msgid "``(float, 0 to 1)`` Opacity of the subject outline."
msgstr "``(float, 0 do 1)`` Krycie konturu obiektu."

#: ../effects.rst:1381
