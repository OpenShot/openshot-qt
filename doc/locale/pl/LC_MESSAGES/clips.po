msgstr "10%"

#: ../clips.rst:579
msgid "Quiet room tone or microphone noise floor."
msgstr "Cichy ton pomieszczenia lub poziom szumu mikrofonu."

#: ../clips.rst:580
msgid "``-60 dBFS``"
msgstr "``-60 dBFS``"

#: ../clips.rst:580
