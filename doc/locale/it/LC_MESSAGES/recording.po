msgid ":ref:`clips_cutting_slicing_ref` for trimming and slicing."
msgstr ":ref:`clips_cutting_slicing_ref` per tagliare e affettare."

#: ../recording.rst:343
msgid ""
":ref:`clip_presets_ref` for waveform, volume, fade, and other clip actions."
msgstr ""
":ref:`clip_presets_ref` per forma d'onda, volume, dissolvenza e altre azioni"
" sui clip."

#: ../recording.rst:344
msgid ""
":ref:`clip_properties_ref` for webcam placement and detailed adjustments."
msgstr ""
":ref:`clip_properties_ref` per il posizionamento della webcam e regolazioni "
"dettagliate."

