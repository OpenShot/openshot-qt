#: ../main_window.rst:408
msgid "Analyze brightness distribution across the current preview frame."
msgstr "Phân tích phân bố độ sáng trên khung xem trước hiện tại."

#: ../main_window.rst:409
msgid "Audio Levels"
msgstr "Mức Âm Thanh"

#: ../main_window.rst:410
msgid "Monitor audio level scope data for the current preview frame."
msgstr "Giám sát dữ liệu phạm vi mức âm thanh cho khung xem trước hiện tại."

# Translated with gpt-4.1-mini
#: ../main_window.rst:412
msgid ""
"View and manage all the media files imported into your project. Organize, "
"filter, and tag video, audio, and image files. See :ref:`files_ref`."
msgstr ""
"Xem và quản lý tất cả các tệp phương tiện đã nhập vào dự án của bạn. Sắp "
