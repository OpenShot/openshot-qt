# Translated with gpt-4.1-mini
#: ../main_window.rst:403
msgid "Emojis"
msgstr "Biểu tượng cảm xúc"

# Translated with gpt-4.1-mini
#: ../main_window.rst:404
msgid ""
"Add emoji graphics to your video project. Choose from a variety of emojis to"
" enhance your video content."
msgstr ""
"Thêm hình ảnh biểu tượng cảm xúc vào dự án video của bạn. Chọn từ nhiều biểu"
" tượng cảm xúc để tăng cường nội dung video."

#: ../main_window.rst:405
msgid "Histogram"
msgstr "Biểu Đồ Phổ"

#: ../main_window.rst:406
msgid ""
"Analyze the tonal and channel distribution of the current preview frame."
