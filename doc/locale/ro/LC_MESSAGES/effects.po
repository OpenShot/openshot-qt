# Translated with gpt-4.1-mini
#: ../doc/effects.rst:463
msgid ""
"**Subtle “home video”**: ``tracking=0.25``, ``bleed=0.20``, "
"``softness=0.20``, ``noise=0.25``, ``stripe=0.10``, ``static_bands=0.05``."
msgstr ""
"**„Home video” subtil**: ``tracking=0.25``, ``bleed=0.20``, "
