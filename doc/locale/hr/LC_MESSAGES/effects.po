"iskrivljenja."

# Translated with gpt-4.1-mini
#: ../doc/effects.rst:453
msgid "bleed"
msgstr "bleed"

# Translated with gpt-4.1-mini
#: ../doc/effects.rst:453
msgid ""
"``(float, 0–1)`` **Chroma bleed / fringing.** Horizontal chroma shift + blur"
