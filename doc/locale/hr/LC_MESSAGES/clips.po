msgstr "Snažniji, oštriji kontrast koristeći gornji sloj za promjenu."

# Translated with gpt-4.1-mini
#: ../clips.rst:771
msgid "Difference"
msgstr "Difference"

# Translated with gpt-4.1-mini
#: ../clips.rst:771
msgid ""
"Absolute difference between layers. Creates inverted/psychedelic colors; "
