#: ../clips.rst:765
msgid "Screen"
msgstr "Screen"

# Translated with gpt-4.1-mini
#: ../clips.rst:765
msgid "The opposite of Multiply. Brightens; great for light, glow, fire, fog."
msgstr ""
"Suprotno od Multiply. Posvjetljuje; izvrsno za svjetlo, sjaj, vatru, maglu."

# Translated with gpt-4.1-mini
#: ../clips.rst:766
msgid "Color Dodge"
msgstr "Color Dodge"

# Translated with gpt-4.1-mini
#: ../clips.rst:766
msgid "Brightens highlights strongly; can blow out to white."
msgstr "Jako posvjetljuje istaknute dijelove; može izgorjeti do bijele."

# Translated with gpt-4.1-mini
#: ../clips.rst:767
msgid "Add"
