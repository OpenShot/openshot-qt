# Translated with gpt-4.1-mini
#: ../clips.rst:762
msgid "Multiply"
msgstr "Pomnoži"

# Translated with gpt-4.1-mini
#: ../clips.rst:762
msgid "Multiplies colors. Darkens and helps textures sit on top of footage."
msgstr "Množi boje. Potamnjuje i pomaže teksturama da se istaknu na snimci."

# Translated with gpt-4.1-mini
#: ../clips.rst:763
msgid "Color Burn"
msgstr "Color Burn"

# Translated with gpt-4.1-mini
#: ../clips.rst:763
