# Translated with gpt-4.1-mini
#: ../clips.rst:769
msgid "Soft Light"
msgstr "Soft Light"

# Translated with gpt-4.1-mini
#: ../clips.rst:769
msgid "Gentle contrast curve; softer than Overlay."
msgstr "Nježna kontrastna krivulja; mekša od Overlay."

# Translated with gpt-4.1-mini
#: ../clips.rst:770
msgid "Hard Light"
msgstr "Hard Light"

# Translated with gpt-4.1-mini
#: ../clips.rst:770
