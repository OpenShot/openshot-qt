msgstr ":kbd:`Ctrl+Lijevo` / :kbd:`Ctrl+Desno`"

#: ../doc/keyboard.rst:190
msgid "Select an item above / below"
msgstr "Odaberi stavku iznad / ispod"

#: ../doc/keyboard.rst:191
msgid ":kbd:`Ctrl+Up` / :kbd:`Ctrl+Down`"
msgstr ":kbd:`Ctrl+Gore` / :kbd:`Ctrl+Dolje`"

#: ../doc/keyboard.rst:192
msgid "Extend selection to the previous / next item"
msgstr "Proširi odabir na prethodnu / sljedeću stavku"

#: ../doc/keyboard.rst:193
