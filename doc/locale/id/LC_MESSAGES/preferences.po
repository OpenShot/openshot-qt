# Translated with gpt-4.1-mini
#: ../doc/preferences.rst:302
msgid "Cache Pre-roll: Min Frames:"
msgstr "Cache Pre-roll: Frame Minimum:"

# Translated with gpt-4.1-mini
#: ../doc/preferences.rst:302
msgid ""
"Minimum # of frames that must be cached before playback begins. The larger "
"the #, the larger the wait before playback begins."
msgstr ""
"Jumlah minimum frame yang harus di-cache sebelum pemutaran dimulai. Semakin "
"besar jumlahnya, semakin lama waktu tunggu sebelum pemutaran dimulai."

# Translated with gpt-4.1-mini
