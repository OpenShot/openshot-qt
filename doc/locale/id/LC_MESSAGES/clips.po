#: ../clips.rst:450
msgid ""
":guilabel:`Level` — sets a fixed volume percentage (0 % to 130 %) for the "
"entire clip."
msgstr ""
":guilabel:`Level` — mengatur persentase volume tetap (0 % hingga 130 %) "
"untuk seluruh klip."

#: ../clips.rst:451
msgid ""
":guilabel:`Fade In` → :guilabel:`Fast` / :guilabel:`Slow` — fades volume "
"from silence at the start of the clip."
msgstr ""
":guilabel:`Fade In` → :guilabel:`Cepat` / :guilabel:`Lambat` — memudar "
