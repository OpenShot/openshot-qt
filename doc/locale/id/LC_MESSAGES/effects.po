msgid "mask_alpha"
msgstr "alfa_masker"

#: ../doc/effects.rst:1378
msgid "``(float, 0 to 1)`` Opacity of the colored mask overlay."
msgstr "``(float, 0 sampai 1)`` Opasitas lapisan overlay masker berwarna."

#: ../doc/effects.rst:1379
msgid "stroke_color"
msgstr "warna_garis"

#: ../doc/effects.rst:1379
msgid "``(color)`` Color of the outline around the selected subject."
msgstr "``(color)`` Warna garis tepi di sekitar subjek yang dipilih."

