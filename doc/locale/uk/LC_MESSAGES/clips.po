# Translated with gpt-4.1-mini
#: ../clips.rst:358
msgid ":guilabel:`Custom…` – opens a dialog for extra options (see below)"
msgstr ""
":guilabel:`Custom…` – відкриває діалог для додаткових опцій (див. нижче)"

# Translated with gpt-4.1-mini
#: ../clips.rst:360
msgid ""
"Counts are **finite** (2x, 3x, 4x, 5x, 8x, 10x, or a custom number). "
