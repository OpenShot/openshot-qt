# Translated with gpt-4.1-mini
#: ../doc/effects.rst:60
msgid ""
"Adjust :guilabel:`Mask Mode` (for example, *Limit to Mask* or *Vary "
"Strength*)."
msgstr ""
"Ajusta el :guilabel:`Modo de Máscara` (por ejemplo, *Limitar a Máscara* o "
