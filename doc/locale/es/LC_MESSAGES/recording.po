msgstr "MP4 de pantalla; desactive Audio del sistema si desea silencio."

#: ../doc/recording.rst:277
msgid "Game commentary"
msgstr "Comentario de juego"

#: ../doc/recording.rst:278
msgid "Mic + Screen"
msgstr "Micrófono + Pantalla"

#: ../doc/recording.rst:279
msgid "Separate mic clip plus screen video with game audio."
msgstr "Clip de micrófono separado más video de pantalla con audio del juego."

