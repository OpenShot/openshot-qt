#: ../clips.rst:270
msgid ""
"**Bounce In** (Center / From Bottom / Left / Right / Top) — clip bounces as "
"it enters."
msgstr ""
"**Entrada con rebote** (Centro / Desde abajo / izquierda / derecha / arriba)"
" — el clip rebota al entrar."

#: ../clips.rst:271
msgid ""
"**Focus Wipe In** (Circle Expand / Circle Shrink / From Bottom / Left / "
"Right / Top) — clip is revealed by a wipe while sharpening from blur into "
"focus."
msgstr ""
"**Entrada con barrido de enfoque** (Círculo expandir / Círculo contraer / "
"Desde abajo / izquierda / derecha / arriba) — el clip se revela con un "
"barrido mientras se enfoca desde el desenfoque."

#: ../clips.rst:272
msgid "**Pop In** — clip scales up quickly from nothing."
msgstr "**Entrada emergente** — el clip se escala rápidamente desde nada."

#: ../clips.rst:273
msgid ""
"**Slide In** (From Bottom / Left / Right / Top) — clip slides onto the "
"screen."
msgstr ""
"**Entrada deslizante** (Desde abajo / izquierda / derecha / arriba) — el "
"clip se desliza en la pantalla."

#: ../clips.rst:274
msgid "**Spiral In** — clip rotates in while scaling up."
msgstr ""
"**Entrada en espiral** — el clip gira mientras se escala hacia arriba."

#: ../clips.rst:275
msgid ""
"**Wipe In** (Circle Expand / Circle Shrink / From Bottom / Left / Right / "
"Top) — clip is revealed by a wipe."
msgstr ""
"**Entrada con barrido** (Círculo expandir / Círculo contraer / Desde abajo /"
" izquierda / derecha / arriba) — el clip se revela con un barrido."

