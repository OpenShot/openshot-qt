msgstr "一个可编辑的旁白文件。"

#: ../doc/recording.rst:274
msgid "Silent tutorial"
msgstr "无声教程"

#: ../doc/recording.rst:276
msgid "Screen MP4; turn System Audio Off if silence is desired."
msgstr "屏幕 MP4；如果需要静音，请关闭系统音频。"

#: ../doc/recording.rst:277
msgid "Game commentary"
msgstr "游戏解说"

#: ../doc/recording.rst:278
msgid "Mic + Screen"
msgstr "麦克风 + 屏幕"

