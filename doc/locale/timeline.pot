msgid "Most editing sessions follow a similar flow:"
msgstr ""

#: ../doc/timeline.rst:77
msgid "Add media to the project using :ref:`import_files_ref`."
msgstr ""

#: ../doc/timeline.rst:78
msgid "Drag files from the project panel onto timeline tracks."
msgstr ""

#: ../doc/timeline.rst:79
msgid "Trim clip edges to remove extra content."
msgstr ""

#: ../doc/timeline.rst:80
msgid "Move clips into order and stack tracks to build your scene."
msgstr ""

#: ../doc/timeline.rst:81
msgid "Add transitions and effects where needed (:ref:`transitions_ref`, :ref:`effects_ref`)."
msgstr ""

#: ../doc/timeline.rst:82
msgid "Preview and adjust timing (:ref:`playback_ref`)."
msgstr ""

#: ../doc/timeline.rst:84
