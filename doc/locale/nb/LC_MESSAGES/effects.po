# Translated with gpt-4.1-mini
#: ../effects.rst:1611
msgid "in_fov"
msgstr "in_fov"

# Translated with gpt-4.1-mini
#: ../effects.rst:1611
msgid ""
"``(float, 1 to 360)`` **In FOV.** Total coverage of the source lens. Used "
"when **Input Model = Fisheye** (typical value 180). Ignored for equirect "
"sources."
msgstr ""
"``(flyttall, 1 til 360)`` **I FOV.** Total dekning av kildens linse. Brukes "
