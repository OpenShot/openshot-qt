#: ../effects.rst:58
msgid ""
"Choose a :guilabel:`Mask: Source` (static image, animated mask video, "
":guilabel:`Tracker`, or :guilabel:`Object Detector`)."
msgstr ""
"Velg en :guilabel:`Mask: Source` (statisk bilde, animert maskevideo, "
