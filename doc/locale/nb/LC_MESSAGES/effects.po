"``(float, -180 to 180)`` Vertical rotation around the right axis (degrees)."
msgstr ""
"``(float, -180 til 180)`` Vertikal rotasjon rundt høyre akse (grader)."

# Translated with gpt-4.1-mini
#: ../effects.rst:1607
msgid "roll"
msgstr "roll"

# Translated with gpt-4.1-mini
#: ../effects.rst:1607
msgid "``(float, -180 to 180)`` Rotation around the forward axis (degrees)."
msgstr "``(float, -180 til 180)`` Rotasjon rundt fremover-aksen (grader)."

# Translated with gpt-4.1-mini
#: ../effects.rst:1609
