msgstr "``(float, 1 to 300)`` اندازه فونت تایمر."

#: ../doc/effects.rst:1692
msgid "format"
msgstr "قالب"

#: ../doc/effects.rst:1692
msgid ""
"``(int, choices: ['MM:SS', 'HH:MM:SS', 'HH:MM:SS.mmm', 'Timecode', "
