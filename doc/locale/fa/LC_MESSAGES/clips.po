# Translated with gpt-4.1-mini
#: ../clips.rst:768
msgid "Overlay"
msgstr "اورلی"

# Translated with gpt-4.1-mini
#: ../clips.rst:768
msgid ""
"Mix of Multiply and Screen using the lower layer to decide. Adds punchy "
