msgstr "هایلایت‌ها را به شدت روشن می‌کند؛ ممکن است به سفید برسد."

# Translated with gpt-4.1-mini
#: ../clips.rst:767
msgid "Add"
msgstr "جمع"

# Translated with gpt-4.1-mini
#: ../clips.rst:767
msgid ""
"Adds pixel values. Strong brightening; clips at white. Also called *Linear "
