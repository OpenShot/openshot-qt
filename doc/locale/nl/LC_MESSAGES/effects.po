# Translated with gpt-4.1-mini
#: ../effects.rst:1313
msgid ""
"``(float, -1 to 1)`` Vertical position of the light source. -1 is top edge, "
"0 is center, +1 is bottom edge."
msgstr ""
"``(float, -1 tot 1)`` Verticale positie van de lichtbron. -1 is de "
"bovenrand, 0 is het midden, +1 is de onderrand."

# Translated with gpt-4.1-mini
#: ../effects.rst:1314
msgid ""
"``(float, 0 to 1)`` Overall glow strength and transparency. Higher values "
"make brighter, more opaque flares."
msgstr ""
"``(float, 0 tot 1)`` Algemene gloedsterkte en transparantie. Hogere waarden "
"maken de flares helderder en ondoorzichtiger."

# Translated with gpt-4.1-mini
#: ../effects.rst:1315
msgid ""
"``(float, 0.1 to 3)`` Scale of the entire flare effect. Larger values "
"enlarge halos, rings and glows."
msgstr ""
"``(float, 0,1 tot 3)`` Schaal van het gehele flare-effect. Grotere waarden "
"vergroten halo's, ringen en gloed."

# Translated with gpt-4.1-mini
#: ../effects.rst:1316
msgid ""
"``(float, 0 to 1)`` How far secondary reflections travel. 0 keeps them close"
" to the source, 1 pushes them all the way toward the opposite edge."
msgstr ""
"``(float, 0 tot 1)`` Hoe ver secundaire reflecties reizen. 0 houdt ze dicht "
