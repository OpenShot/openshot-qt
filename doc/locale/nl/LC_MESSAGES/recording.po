msgid "Silent tutorial"
msgstr "Stille tutorial"

#: ../recording.rst:276
msgid "Screen MP4; turn System Audio Off if silence is desired."
msgstr "Scherm MP4; zet Systeemgeluid uit als stilte gewenst is."

#: ../recording.rst:277
msgid "Game commentary"
msgstr "Spelcommentaar"

#: ../recording.rst:278
msgid "Mic + Screen"
msgstr "Mic + Scherm"

#: ../recording.rst:279
msgid "Separate mic clip plus screen video with game audio."
msgstr "Gescheiden microfoonclip plus schermvideo met spelgeluid."

