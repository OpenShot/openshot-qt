"``(float, 0 ile 10 arasında)`` 720p'de piksel cinsinden bulanıklık yarıçapı "
"(klip boyutuna otomatik ölçeklenir)"

# Translated with gpt-4.1-mini
#: ../effects.rst:1542
msgid "``(float, 0 to 1)`` Minimum luma difference that will be sharpened"
msgstr "``(float, 0 ile 1 arasında)`` Keskinleştirilecek minimum luma farkı"

# Translated with gpt-4.1-mini
#: ../effects.rst:1543
msgid ""
"``(int, choices: ['Unsharp', 'HighPass'])`` Math style of the sharpening "
"mask"
msgstr ""
"``(int, seçenekler: ['Unsharp', 'HighPass'])`` Keskinleştirme maskesinin "
"matematiksel stili"

# Translated with gpt-4.1-mini
#: ../effects.rst:1544
msgid "channel"
msgstr "kanal"

