msgstr ":guilabel:`Dönüş Yok` — tüm dönüş anahtar-karelerini kaldırır."

#: ../clips.rst:301
msgid ":guilabel:`Rotate 90 (Right)` — rotates the clip 90 degrees clockwise."
msgstr ""
":guilabel:`90 Derece Döndür (Sağa)` — klibi saat yönünde 90 derece döndürür."

#: ../clips.rst:302
msgid ""
