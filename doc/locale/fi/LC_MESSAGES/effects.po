msgid "To adjust a property:"
msgstr "Ominaisuuden säätämiseksi:"

# Translated with gpt-4.1-mini
#: ../effects.rst:81
msgid "Drag the slider for coarse changes."
msgstr "Vedä liukusäädintä karkeisiin muutoksiin."

# Translated with gpt-4.1-mini
#: ../effects.rst:82
msgid "Double-click to enter precise values."
