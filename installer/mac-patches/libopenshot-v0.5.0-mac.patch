diff --git a/src/FrameMapper.cpp b/src/FrameMapper.cpp
index 531cd57..4770b36 100644
--- a/src/FrameMapper.cpp
+++ b/src/FrameMapper.cpp
@@ -943,14 +943,31 @@ void FrameMapper::ResampleMappedAudio(std::shared_ptr<Frame> frame, int64_t orig
 	// setup resample context
 	if (!avr) {
 		avr = SWR_ALLOC();
+#if HAVE_CH_LAYOUT
+		// FFmpeg 8: legacy "in_channel_layout"/"out_channel_layout" integer options
+		// are no-ops; must use av_opt_set_chlayout() with AVChannelLayout structs.
+		// Without this, SWR's in/out layouts stay empty → swr_init() reports
+		// "input channel layout '' is invalid" → audio resample never runs →
+		// playback clock never starts → video frames never get delivered.
+		AVChannelLayout in_layout, out_layout;
+		av_channel_layout_default(&in_layout,
+			channels_in_frame > 0 ? channels_in_frame : 2);
+		av_channel_layout_default(&out_layout,
+			info.channels > 0 ? info.channels : 2);
+		av_opt_set_chlayout(avr, "in_chlayout",  &in_layout,  0);
+		av_opt_set_chlayout(avr, "out_chlayout", &out_layout, 0);
+		av_channel_layout_uninit(&in_layout);
+		av_channel_layout_uninit(&out_layout);
+#else
 		av_opt_set_int(avr, "in_channel_layout",  channel_layout_in_frame, 0);
 		av_opt_set_int(avr, "out_channel_layout", info.channel_layout,	 0);
+		av_opt_set_int(avr, "in_channels",		channels_in_frame,	   0);
+		av_opt_set_int(avr, "out_channels",	   info.channels,		   0);
+#endif
 		av_opt_set_int(avr, "in_sample_fmt",	  AV_SAMPLE_FMT_S16,	   0);
 		av_opt_set_int(avr, "out_sample_fmt",	 AV_SAMPLE_FMT_S16,	   0);
 		av_opt_set_int(avr, "in_sample_rate",	 sample_rate_in_frame,	0);
 		av_opt_set_int(avr, "out_sample_rate",	info.sample_rate,		0);
-		av_opt_set_int(avr, "in_channels",		channels_in_frame,	   0);
-		av_opt_set_int(avr, "out_channels",	   info.channels,		   0);
 		SWR_INIT(avr);
 	}
 
