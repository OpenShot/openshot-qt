#!/bin/bash
# Get directory containing this script (requires bash for BASH_SOURCE)
CURR_DIR="$( cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd )"

# Set library and plugin paths for ImageMagick and Qt5
export DYLD_LIBRARY_PATH="$CURR_DIR"
export MAGICK_CONFIGURE_PATH="$CURR_DIR/ImageMagick/etc/configuration"
export MAGICK_CODER_MODULE_PATH="$CURR_DIR/ImageMagick/modules-Q16/coders"
export QT_PLUGIN_PATH="$CURR_DIR"

# Launch application
exec "$CURR_DIR/zenvi" "$@"
